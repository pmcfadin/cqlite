# astro-processor.env — box profile for scripts/flow/gate-box-launch.sh (#4267).
#
# astro-processor: WSL2 Ubuntu 22.04, Tailscale 100.107.125.78, ssh user pmcfadin (see
# memory/project_linux_gate_box_astro_processor.md — always `ssh pmcfadin@astro-processor`,
# a bare hostname defaults to a different local user and fails as a misleading
# "Permission denied (publickey,password)").
#
# This file is sourced by gate-box-launch.sh, plain `NAME=value` assignments only — no
# command substitution, no arbitrary shell. It is COMMITTED, reviewed source, not
# untrusted input: sourcing it is the same trust boundary as sourcing any other script in
# this repo.
#
# One profile per host, selected by `--box <name>` or by `hostname -s` (#4267 AC).

# Canonical clone the launcher fetches into and cuts lane worktrees FROM. A PRIMARY clone
# fails 68 worker-supervisor cases (#3393); only a `git worktree add` of THIS clone passes.
BOX_CANONICAL_CLONE="/home/pmcfadin/workspace/repo"

# Where lane worktrees live. One REAL in-tree target/ per lane — never a shared
# CARGO_TARGET_DIR (voids gates, see the memory file) — so budget ~120-190G per lane here.
BOX_LANES_DIR="/home/pmcfadin/workspace/lanes"

# tmpfs TMPDIR. Must be a SHORT path: the claude-auth-capability cold-start probe refuses
# a nested temp dir once its socket path gets too long, which ruled out /mnt/gatetmp/...
BOX_TMPDIR="/data/tmp"

# Dataset root, verified (never mutated) via test-data/scripts/fetch-datasets.sh
# --verify-only before every launch.
BOX_DATASETS_ROOT="/home/pmcfadin/workspace/repo/test-data/datasets"

# PATH the gate runs under. Deliberately npx-FREE (#4238: with npx resolvable, two
# cqlite-core tests shell out to `npx claude-flow@alpha` and time out at 240s) — node/npm
# come from ~/.local/bin symlinks with no npx sibling. ~/opt/gate-tools/bin holds sccache +
# cargo-nextest, installed deliberately off the box's default PATH.
BOX_PATH="/home/pmcfadin/opt/gate-tools/bin:/home/pmcfadin/.cargo/bin:/home/pmcfadin/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

# sccache: RUSTC_WRAPPER + cache dir, sized. Cache lives on /data (not the tmpfs) so it
# survives a reboot; -launch checks the binary exists on BOX_PATH before wiring it in.
BOX_SCCACHE_DIR="/data/sccache"
BOX_SCCACHE_SIZE="50G"

# Default AGENT_GATE_JOBS for this box (issue #4267: raised from the 1-job recipe now that
# sccache/nextest are installed).
BOX_JOBS=4

# RUST_TEST_THREADS stays 1 for now — #4144 (proc_thread_gauge flake under parallel lanes).
# Drop this once #4144 merges; leaving the comment so the next editor knows why it is here.
BOX_RUST_TEST_THREADS=1

# CQLITE_GATE_MAX_CONCURRENCY: this box's single-gate pin (bootstrap-agent-machine.sh
# --fix-gate-pin also persists this into /etc/environment; kept here too so the launcher
# does not depend on that having been run).
BOX_MAX_CONCURRENCY=1

# Disk admission bar, in GB free, checked against BOX_LANES_DIR's filesystem — the box's
# main disk, hundreds of GB, and the vhdx-exhaustion axis this exists for (it has died to
# silent disk exhaustion twice — see the memory file's "R:\ hit 100%" incident).
BOX_MIN_FREE_GB=150

# A SEPARATE, much smaller bar for BOX_TMPDIR: /data/tmp is a tmpfs whose TOTAL size is a
# fixed 48G mount option, not a share of the main disk, so BOX_MIN_FREE_GB's 150G would
# refuse EVERY launch unconditionally (found running --dry-run against this box, #4267
# endgame — the tmpfs can never hold 150G free even empty). 8G leaves headroom for the
# gate's own scratch use of TMPDIR without demanding more than the mount can ever have.
BOX_TMP_MIN_FREE_GB=8

# Where launch artifacts (summary/log) default to when the caller doesn't pass --summary/
# --log through to gate-detached.sh.
BOX_LOG_DIR="/home/pmcfadin/logs"
