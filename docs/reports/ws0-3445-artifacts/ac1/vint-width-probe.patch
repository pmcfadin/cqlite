 /// table and no `fixed → zigzag` double-decode fallback.
 ///
 /// Returns `(value, bytes_consumed)` where `bytes_consumed == leading_ones + 1`.
+/// MEASUREMENT PROBE ONLY (issue #3445) — never committed to a CQLite branch.
+///
+/// Counts decoded VInt widths so the corpus's width distribution can be OBSERVED rather
+/// than argued from the schema. Relaxed atomics on a static array: this perturbs the hot
+/// loop, which is why the probe's TIMING is discarded and only its DISTRIBUTION is used.
+pub static VINT_WIDTH_COUNTS: [std::sync::atomic::AtomicU64; 10] = [
+    std::sync::atomic::AtomicU64::new(0), std::sync::atomic::AtomicU64::new(0),
+    std::sync::atomic::AtomicU64::new(0), std::sync::atomic::AtomicU64::new(0),
+    std::sync::atomic::AtomicU64::new(0), std::sync::atomic::AtomicU64::new(0),
+    std::sync::atomic::AtomicU64::new(0), std::sync::atomic::AtomicU64::new(0),
+    std::sync::atomic::AtomicU64::new(0), std::sync::atomic::AtomicU64::new(0),
+];
+
+#[inline]
+fn probe_record_width(total: usize) {
+    use std::sync::atomic::Ordering::Relaxed;
+    let n = VINT_WIDTH_COUNTS[total.min(9)].fetch_add(1, Relaxed);
+    // One dump per 25M decodes of a given width, to stderr, so the histogram is observable without
+    // touching the harness. The scan performs far more than this per pass.
+    if n % 25_000_000 == 24_999_999 {
+        let v: Vec<String> = (1..=9)
+            .map(|w| format!("{}:{}", w, VINT_WIDTH_COUNTS[w].load(Relaxed)))
+            .collect();
+        eprintln!("VINT_WIDTH_HISTOGRAM {}", v.join(" "));
+    }
+}
