{
  "monitoring": {
    "enabled": true,
    "version": "1.0.0",
    "schedules": {
      "critical_check": "0 */6 * * *",
      "daily_report": "0 9 * * 1-5",
      "weekly_summary": "0 9 * * 1"
    }
  },
  "issues": {
    "critical": [
      {
        "number": 8,
        "title": "Compilation errors",
        "assignee": "SeniorDev1",
        "priority": "critical",
        "category": "compilation",
        "sla_hours": 24,
        "validation_gates": ["compilation"]
      },
      {
        "number": 9,
        "title": "Test infrastructure",
        "assignee": "SeniorDev2", 
        "priority": "critical",
        "category": "testing",
        "sla_hours": 24,
        "validation_gates": ["testing"]
      },
      {
        "number": 14,
        "title": "CI/CD quality gates",
        "assignee": null,
        "priority": "critical",
        "category": "ci-cd",
        "sla_hours": 12,
        "validation_gates": ["cicd"]
      }
    ],
    "medium": [
      {
        "number": 10,
        "title": "Cassandra data validation",
        "priority": "medium",
        "category": "data-validation",
        "sla_hours": 72,
        "validation_gates": ["dataValidation"]
      },
      {
        "number": 11,
        "title": "Scope alignment and tech debt",
        "priority": "medium",
        "category": "tech-debt",
        "sla_hours": 120
      },
      {
        "number": 13,
        "title": "Phase 2 readiness criteria",
        "priority": "medium", 
        "category": "phase-2",
        "sla_hours": 168
      },
      {
        "number": 15,
        "title": "Performance baselines",
        "priority": "medium",
        "category": "performance",
        "sla_hours": 96,
        "validation_gates": ["performance"]
      }
    ],
    "low": [
      {
        "number": 12,
        "title": "SSTable writer implementation",
        "priority": "low",
        "category": "implementation",
        "sla_hours": 240
      }
    ]
  },
  "validation_gates": {
    "compilation": {
      "name": "Compilation Gate",
      "description": "Ensures code compiles successfully without errors",
      "checks": [
        "build-success",
        "no-warnings", 
        "dependency-resolution"
      ],
      "dependencies": [],
      "timeout_hours": 2
    },
    "testing": {
      "name": "Testing Gate",
      "description": "Validates test infrastructure and coverage",
      "checks": [
        "unit-tests",
        "integration-tests",
        "coverage-threshold"
      ],
      "dependencies": ["compilation"],
      "timeout_hours": 4
    },
    "cicd": {
      "name": "CI/CD Gate",
      "description": "Ensures pipeline and quality gates are functional",
      "checks": [
        "pipeline-setup",
        "quality-gates",
        "deployment-ready"
      ],
      "dependencies": ["compilation", "testing"],
      "timeout_hours": 6
    },
    "dataValidation": {
      "name": "Data Validation Gate",
      "description": "Validates data integrity and migration safety",
      "checks": [
        "data-integrity",
        "schema-validation", 
        "migration-safety"
      ],
      "dependencies": ["compilation"],
      "timeout_hours": 8
    },
    "performance": {
      "name": "Performance Gate",
      "description": "Establishes performance baselines and benchmarks",
      "checks": [
        "baseline-established",
        "benchmarks-passing",
        "no-regressions"
      ],
      "dependencies": ["compilation", "testing"],
      "timeout_hours": 12
    }
  },
  "notifications": {
    "channels": {
      "github_issues": {
        "enabled": true,
        "urgency_threshold": "medium",
        "create_new_issue": true,
        "monitoring_issue_number": 16
      },
      "github_comments": {
        "enabled": true,
        "urgency_threshold": "low"
      },
      "team_discussions": {
        "enabled": false,
        "team_slug": "developers"
      }
    },
    "escalation": {
      "critical_sla_breach": {
        "action": "create_urgent_issue",
        "assignees": ["project-lead", "tech-lead"],
        "labels": ["urgent", "sla-breach", "critical"]
      },
      "multiple_blockers": {
        "threshold": 3,
        "action": "escalate_to_management"
      },
      "high_risk_score": {
        "threshold": 80,
        "action": "daily_standups"
      }
    }
  },
  "metrics": {
    "sla_targets": {
      "critical_resolution": 24,
      "medium_resolution": 72,
      "low_resolution": 168
    },
    "quality_targets": {
      "validation_gate_success": 90,
      "first_time_fix_rate": 85,
      "reopen_rate": 5
    },
    "velocity_targets": {
      "issues_per_week": 3,
      "completion_rate": 80
    }
  },
  "automation": {
    "auto_assignment": {
      "enabled": true,
      "rules": [
        {
          "condition": "issue.labels.includes('critical') && !issue.assignee",
          "action": "assign_to_available_senior_dev"
        },
        {
          "condition": "issue.category === 'compilation'",
          "action": "assign_to_build_expert"
        },
        {
          "condition": "issue.category === 'testing'", 
          "action": "assign_to_qa_lead"
        }
      ]
    },
    "labeling": {
      "enabled": true,
      "auto_labels": {
        "stale": {
          "condition": "hours_since_update > 48",
          "label": "stale"
        },
        "overdue": {
          "condition": "days_since_created > sla_hours/24",
          "label": "overdue"
        },
        "blocked": {
          "condition": "contains_blocker_keywords",
          "label": "blocked"
        }
      }
    },
    "validation_tracking": {
      "enabled": true,
      "auto_validate": {
        "on_pr_merge": true,
        "on_milestone_completion": true,
        "on_label_change": true
      }
    }
  },
  "reporting": {
    "formats": ["markdown", "json"],
    "retention_days": 90,
    "dashboard_update_frequency": "6h",
    "summary_frequency": "daily",
    "trends": {
      "track_velocity": true,
      "track_quality": true,
      "track_blockers": true,
      "track_sla_compliance": true
    }
  }
}