#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
IMAGE="docker.io/library/python:3.12-slim"
POD_NAME="trino-loadtest-${KIT_NAME}-$(date +%s)"
CONFIGMAP_NAME="${POD_NAME}-driver"
VICTORIA_URL="http://${CONTROL_HOST_PRIVATE}:8428/api/v1/import/prometheus"

# The trino kit's "Trino UI" http endpoint resolves to TARGET_HTTP_URL
# (KitEndpointResolver, kit-ref arg --target) — reuse it as the coordinator
# address rather than hardcoding a port.
if [ -z "${TARGET_HTTP_URL:-}" ]; then
  echo "Error: TARGET_HTTP_URL not set. Install with --target pointing at a running trino kit that exposes an http endpoint." >&2
  exit 1
fi
TRINO_HOST_PORT="${TARGET_HTTP_URL#http://}"
TRINO_HOST_PORT="${TRINO_HOST_PORT#https://}"
TRINO_HOST="${TRINO_HOST_PORT%%:*}"
TRINO_PORT="${TRINO_HOST_PORT##*:}"
TRINO_USER="${TARGET_JDBC_USER:-cqlite-loadtest}"

QUERIES_FLAG=""
CONFIGMAP_FILE_ARGS=(--from-file="driver.py=${SCRIPT_DIR}/../driver.py")
if [ -n "${TRINO_LOADTEST_QUERIES_FILE:-}" ]; then
  CONFIGMAP_FILE_ARGS+=(--from-file="queries.txt=${TRINO_LOADTEST_QUERIES_FILE}")
  QUERIES_FLAG="--queries-file /driver/queries.txt"
fi

echo "Starting trino-loadtest: coordinator=${TRINO_HOST}:${TRINO_PORT}, ks=${TRINO_LOADTEST_KEYSPACE:-<none>}, tbl=${TRINO_LOADTEST_TABLE:-<none>}, threads=${THREADS}, duration=${DURATION}s, interval=${INTERVAL}s, traceparent=${TRACEPARENT}..."

# Stage driver.py (and an optional queries file) into a labelled ConfigMap the
# pod mounts read-only at /driver. Labelled so stop.sh's label-selector delete
# also removes it — no per-run cleanup step needed beyond `stop`.
kubectl --kubeconfig="${KUBECONFIG}" create configmap "${CONFIGMAP_NAME}" \
  "${CONFIGMAP_FILE_ARGS[@]}" \
  --dry-run=client -o yaml \
  | kubectl --kubeconfig="${KUBECONFIG}" label --local -f - \
      "easydblab.com/kit=${KIT_NAME}" "easydblab.com/role=trino-loadtest-run" \
      --dry-run=client -o yaml \
  | kubectl --kubeconfig="${KUBECONFIG}" apply -f -

TRACEPARENT_FLAG=""
if [ "${TRACEPARENT}" = "true" ]; then
  TRACEPARENT_FLAG="--traceparent"
fi

kubectl --kubeconfig="${KUBECONFIG}" apply -f - <<PODSPEC
apiVersion: v1
kind: Pod
metadata:
  name: ${POD_NAME}
  labels:
    easydblab.com/kit: "${KIT_NAME}"
    easydblab.com/role: trino-loadtest-run
spec:
  restartPolicy: Never
  containers:
    - name: trino-loadtest
      image: ${IMAGE}
      command: ["sh", "-c"]
      args:
        - >-
          pip install --quiet trino &&
          python /driver/driver.py
          --host "${TRINO_HOST}" --port "${TRINO_PORT}" --user "${TRINO_USER}"
          --ks "${TRINO_LOADTEST_KEYSPACE:-}" --tbl "${TRINO_LOADTEST_TABLE:-}"
          ${QUERIES_FLAG}
          --threads "${THREADS}" --duration "${DURATION}" --interval "${INTERVAL}"
          ${TRACEPARENT_FLAG}
      volumeMounts:
        - name: driver
          mountPath: /driver
          readOnly: true
  volumes:
    - name: driver
      configMap:
        name: ${CONFIGMAP_NAME}
PODSPEC

kubectl --kubeconfig="${KUBECONFIG}" wait \
  --for=condition=ready \
  --timeout=60s \
  pod/"${POD_NAME}"

# Stream logs, echo every line, and push interval stats to VictoriaMetrics.
# Interval lines match: "[ Ns ] threads: N qps: N.NN rows_s: N.NN lat_p50_ms: N.NN lat_p99_ms: N.NN err_s: N.NN"
# (driver.py's format_interval_line — the trailing "[ final ]" summary line
# deliberately does not match this pattern and is only echoed, never pushed.)
kubectl --kubeconfig="${KUBECONFIG}" logs -f "${POD_NAME}" | while IFS= read -r line; do
  echo "$line"
  if [[ "$line" =~ ^\[\ [0-9]+s\ \] ]]; then
    read -r QPS ROWS_S LAT_P50 LAT_P99 ERR_S <<< "$(echo "$line" | awk '{
      for (i=1; i<=NF; i++) {
        if ($i == "qps:") qps=$(i+1)
        if ($i == "rows_s:") rows=$(i+1)
        if ($i == "lat_p50_ms:") p50=$(i+1)
        if ($i == "lat_p99_ms:") p99=$(i+1)
        if ($i == "err_s:") errs=$(i+1)
      }
      print qps, rows, p50, p99, errs
    }')"
    curl -sf --max-time 2 -X POST "${VICTORIA_URL}" \
      --data-binary "trino_loadtest_qps{kit=\"${KIT_NAME}\"} ${QPS:-0}
trino_loadtest_rows_per_sec{kit=\"${KIT_NAME}\"} ${ROWS_S:-0}
trino_loadtest_lat_p50_ms{kit=\"${KIT_NAME}\"} ${LAT_P50:-0}
trino_loadtest_lat_p99_ms{kit=\"${KIT_NAME}\"} ${LAT_P99:-0}
trino_loadtest_errors_per_second{kit=\"${KIT_NAME}\"} ${ERR_S:-0}" 2>/dev/null || true
  fi
done

echo "trino-loadtest run complete (pod: ${POD_NAME}). Run '${KIT_NAME} stop' to clean up the pod and ConfigMap."
