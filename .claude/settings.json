{
  "agent": "flow-lead",
  "env": {
    "ISSUE_GATE_TEST_CMD": "scripts/agent-gate.sh",
    "ISSUE_GATE_COVERAGE_CMD": ""
  },
  "permissions": {
    "allow": [
      "Bash(npx claude-flow:*)",
      "Bash(npm run lint)",
      "Bash(npm run test:*)",
      "Bash(npm test:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git push)",
      "Bash(git config:*)",
      "Bash(git tag:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git stash:*)",
      "Bash(git rev-parse:*)",
      "Bash(jq:*)",
      "Bash(node:*)",
      "Bash(which:*)",
      "Bash(pwd)",
      "Bash(ls:*)",
      "Bash(ls)",
      "Bash(env RUSTFLAGS=\"-D warnings\" cargo clippy:*)",
      "Bash(env RUSTFLAGS=\"-D warnings\" cargo clippy)",
      "Bash(env RUSTFLAGS=\"-D warnings\" cargo build:*)",
      "Bash(env RUSTFLAGS=\"-D warnings\" cargo build)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh issue edit:*)",
      "Bash(gh issue close:*)",
      "Bash(gh issue reopen:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo test:*)",
      "Bash(hexdump:*)",
      "Bash(roborev:*)"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(eval:*)"
    ]
  },
  "includeCoAuthoredBy": false,
  "hooks": {
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/issue-gate.sh\"",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
