{
  "name": "@cqlite/node",
  "version": "0.12.0",
  "description": "Node.js bindings for CQLite - read Apache Cassandra 5.0 SSTables without cluster dependencies",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "napi": {
    "binaryName": "cqlite-node",
    "targets": [
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc"
    ]
  },
  "files": [
    "index.js",
    "lib",
    "*.node",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "build": "napi build --platform --profile release-unwind --features write-support",
    "postbuild": "node scripts/generate-loader.mjs",
    "build:debug": "napi build --platform --features write-support",
    "pretest": "node scripts/generate-loader.mjs",
    "test": "node --expose-gc node_modules/.bin/jest",
    "test:watch": "node --expose-gc node_modules/.bin/jest --watch",
    "test:coverage": "node --expose-gc node_modules/.bin/jest --coverage",
    "test:parity": "jest parity.test.js --testTimeout=60000",
    "typecheck": "tsc --noEmit -p examples/tsconfig.json",
    "examples": "ts-node examples/basic-query.ts",
    "prepublishOnly": "echo 'Skipping napi prepublish - artifacts handled by CI workflow'"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.5.1",
    "@types/node": "^20.0.0",
    "jest": "^29.7.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">= 18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pmcfadin/cqlite.git",
    "directory": "bindings/node"
  },
  "license": "MIT OR Apache-2.0",
  "keywords": [
    "cassandra",
    "sstable",
    "database",
    "cql",
    "cqlite"
  ],
  "author": "CQLite Team",
  "homepage": "https://github.com/pmcfadin/cqlite#readme",
  "bugs": {
    "url": "https://github.com/pmcfadin/cqlite/issues"
  }
}
