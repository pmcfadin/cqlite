{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "declaration": false,
    "rootDir": ".",
    "baseUrl": "..",
    "paths": {
      "@cqlite/node": ["./lib/index.d.ts"]
    }
  },
  "include": ["*.ts"],
  "exclude": ["node_modules"]
}
