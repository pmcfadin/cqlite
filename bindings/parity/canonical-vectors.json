    {
      "name": "proto_polluting_column_names",
      "_why": "issue #1455 F1: `__proto__` is a legal quoted CQL identifier (test-data/schemas/issue-3630-row-collision.cql). On an ORDINARY JS object both the type map and the canonical row silently LOSE it, because assignment runs Object.prototype's inherited setter instead of creating an own property. `constructor`/`toString`/`valueOf` are inherited DATA properties, which shadow correctly, and are here so a fix that only special-cases `__proto__` is still exercised against the rest of the family.",
      "columns": {
        "id": "uuid",
        "__proto__": "text",
        "constructor": "int",
        "toString": "boolean",
        "valueOf": "decimal",
        "prototype": "blob"
      },
      "python": {
        "id": {
          "$": "uuid",
          "v": "15291a77-d739-4e73-8397-b787442f3a1f"
        },
        "__proto__": "survived",
        "constructor": 5,
        "toString": true,
        "valueOf": {
          "$": "decimal",
          "v": "1.50"
        },
        "prototype": {
          "$": "bytes",
          "hex": "00ff"
        }
      },
      "node": {
        "id": "15291a77-d739-4e73-8397-b787442f3a1f",
        "__proto__": "survived",
        "constructor": 5,
        "toString": true,
        "valueOf": "1.50",
        "prototype": {
          "$": "bytes",
          "hex": "00ff"
        }
      },
      "cli": {
        "id": "15291a77-d739-4e73-8397-b787442f3a1f",
        "__proto__": "survived",
        "constructor": 5,
        "toString": true,
        "valueOf": "1.50",
        "prototype": "0x00ff"
      },
      "canonical": {
        "id": "15291a77-d739-4e73-8397-b787442f3a1f",
        "__proto__": "survived",
        "constructor": 5,
        "toString": true,
        "valueOf": "1.50",
        "prototype": "0x00ff"
      }
    },
