-- Field-repro "tiny" fixture (issue #2289, #2193 pinned check): the EXACT
-- canonical shape pinned by the committed Flight-level decode oracle —
-- `cqlite-flight/src/test_fixtures.rs`'s `KEYVALUE_DDL`/`KEYVALUE_ROWS`
-- (`cassandra_easy_stress.keyvalue`: `key text PRIMARY KEY, value text`, 1 pk,
-- 0 ck, 3 rows) and `trino-connector/src/test/resources/golden/keyvalue.flightdata`
-- (regenerated by `trino-connector/scripts/regen-arrow-golden.sh` from the same
-- fixture). ONE flush -> ONE `nb-1-big` SSTable, LZ4 compression.
--
-- Issue #2289 roborev finding (2026-07-10): an earlier revision used a
-- hand-made `fieldrepro.tiny (id int, val text)` shape that decoded correctly
-- even when the real #2193 arrow-java `Failed to read message` failure was
-- present, because it never exercised the TEXT-column/no-clustering-key wire
-- shape the bug actually hits. This keyspace/table/column-type/row-value
-- naming is INTENTIONALLY identical to the golden fixture (not the real
-- `cassandra-easy-stress` load-generator's own keyspace, which this harness
-- uses separately as `loadtest.keyvalue` for the #2264 scale check) so the
-- harness exercises the same Flight-level bytes as
-- `FlightDataGoldenDecodeTest`.
--
-- NB: CQL/cqlsh comments are `--`/`//`/`/* */` ONLY — `#` is NOT a valid CQL
-- comment leader (unlike this repo's YAML/shell conventions) and made cqlsh
-- abort the whole batch with "Invalid syntax" on a real run of this file
-- (issue #2289 field-repro.sh dry run, 2026-07-09) before this fix.
CREATE KEYSPACE IF NOT EXISTS cassandra_easy_stress
  WITH replication = {'class': 'SimpleStrategy', 'replication_factor': 1};

CREATE TABLE IF NOT EXISTS cassandra_easy_stress.keyvalue (
  key text PRIMARY KEY,
  value text
) WITH compression = {'class': 'LZ4Compressor'};

INSERT INTO cassandra_easy_stress.keyvalue (key, value) VALUES ('k1', '1');
INSERT INTO cassandra_easy_stress.keyvalue (key, value) VALUES ('k2', '2');
INSERT INTO cassandra_easy_stress.keyvalue (key, value) VALUES ('k3', '3');
