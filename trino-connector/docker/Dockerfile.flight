# Build the cqlite-flight Arrow Flight server. Build context is the repo root.
FROM rust:1.85-bookworm AS build
WORKDIR /src
COPY . .
RUN cargo build --release -p cqlite-flight

FROM debian:bookworm-slim
RUN useradd -r -u 10001 flight
COPY --from=build /src/target/release/cqlite-flight /usr/local/bin/cqlite-flight
USER flight
EXPOSE 8815
ENTRYPOINT ["/usr/local/bin/cqlite-flight"]
