# Dockerfile for Automated Cassandra Data Generation - Issue #17
# 
# This container generates comprehensive test data across multiple Cassandra versions
# CRITICAL SUCCESS FACTOR: Command-line test execution MUST work reliably!

FROM python:3.11-slim

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    wget \
    netcat-openbsd \
    procps \
    && rm -rf /var/lib/apt/lists/*

# Install Cassandra driver and other Python dependencies
RUN pip install --no-cache-dir \
    cassandra-driver==3.28.0 \
    faker==20.1.0 \
    numpy==1.24.3 \
    pandas==2.0.3 \
    pyyaml==6.0 \
    click==8.1.7 \
    tqdm==4.66.1 \
    psutil==5.9.6 \
    jsonschema==4.19.1

# Create working directory
WORKDIR /app

# Copy data generation scripts
COPY scripts/ /scripts/
COPY schemas/ /schemas/

# Make scripts executable
RUN chmod +x /scripts/*.sh /scripts/*.py

# Create output directory
RUN mkdir -p /generated

# Set environment variables
ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python3 -c "import cassandra; print('OK')" || exit 1

# Default command
CMD ["python3", "/scripts/generate_comprehensive_test_data.py", "--help"]