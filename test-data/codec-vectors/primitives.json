{
  "provenance": {
    "cassandra_version": "5.0.2",
    "description": "Canonical byte-vectors for primitive and special CQL value codecs. Expected bytes are derived from Apache Cassandra 5.0.2 serializer/marshal contracts (org.apache.cassandra.db.marshal.* / serializers.*), NOT from CQLite output, so the tests are non-tautological.",
    "encoding_rules": {
      "boolean": "1 byte: 0x00 = false, 0x01 = true (BooleanType).",
      "tinyint": "1 byte signed (ByteType).",
      "smallint": "2 bytes big-endian signed (ShortType).",
      "int": "4 bytes big-endian signed (Int32Type).",
      "bigint": "8 bytes big-endian signed (LongType / CounterColumnType uses same width).",
      "float": "4 bytes IEEE-754 big-endian (FloatType).",
      "double": "8 bytes IEEE-754 big-endian (DoubleType).",
      "ascii": "raw bytes, each 0x00-0x7F (AsciiType); no length prefix at cell level.",
      "text": "raw UTF-8 bytes (UTF8Type); no length prefix at cell level.",
      "blob": "raw bytes (BytesType); no length prefix at cell level.",
      "uuid": "16 raw bytes (UUIDType); timeuuid identical width (TimeUUIDType).",
      "inet": "4 raw bytes (IPv4) or 16 raw bytes (IPv6) (InetAddressType).",
      "varint": "minimal two's-complement big-endian (IntegerType / java.math.BigInteger.toByteArray()).",
      "decimal": "4-byte big-endian signed scale, followed by varint-encoded unscaled value (DecimalType).",
      "duration": "three signed VInts: months (i32), days (i32), nanos (i64); each value ZigZag-encoded then written with Cassandra VIntCoding (DurationType / DurationSerializer).",
      "date": "4-byte big-endian UNSIGNED int; stored = days_since_epoch + 2^31 (SimpleDateType, Integer.MIN_VALUE offset for byte-order comparability).",
      "time": "8 bytes big-endian signed long: nanoseconds since midnight, range 0..86399999999999 (TimeType).",
      "timestamp": "8 bytes big-endian signed long: milliseconds since Unix epoch (TimestampType)."
    }
  },
